[Unit]
Description=BTC09 OTC Escrow Discord Bot
After=network-online.target btc09-seed.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/btc09
EnvironmentFile=/etc/btc09/discord.env
Environment=FEE_PERCENT=1.0
Environment=BTC09_BIN=/opt/btc09/btc09
Environment=BTC09_DATADIR=/opt/btc09/data
Environment=EXPLORER_URL=http://localhost:8009
Environment=DB_PATH=/opt/btc09/otc_bot.db
Environment=PUBLIC_FEED_PATH=/opt/btc09/public/otc-bot-feed.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/btc09/venv/bin/python /opt/btc09/btc09_otc_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
