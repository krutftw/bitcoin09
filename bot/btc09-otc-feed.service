[Unit]
Description=BTC09 OTC public feed
After=network-online.target btc09-otc-bot.service
Wants=network-online.target
ConditionPathExists=!/var/lib/btc09-otc-maintenance/active

[Service]
Type=simple
User=btc09-otc-feed
Group=btc09-otc-feed
WorkingDirectory=/opt/btc09/bitcoin09
RuntimeDirectory=btc09-otc-feed
RuntimeDirectoryMode=0755
Environment=OTC_FEED_PATH=/run/btc09-otc-feed/public/otc-bot-feed.json
Environment=OTC_FEED_LISTEN=127.0.0.1
Environment=OTC_FEED_PORT=8019
Environment=OTC_FEED_MAX_AGE_SECONDS=120
Environment=OTC_FEED_MAX_FUTURE_SKEW_SECONDS=5
Environment=OTC_FEED_MAX_WORKERS=8
Environment=OTC_FEED_SOCKET_TIMEOUT_SECONDS=5
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/btc09/venv/bin/python -m bot.serve_otc_feed
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
UMask=0077

CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:8019
BindReadOnlyPaths=/var/lib/btc09-otc-public:/run/btc09-otc-feed/public
InaccessiblePaths=-/var/lib/btc09-otc -/var/lib/btc09-otc-public

[Install]
WantedBy=multi-user.target
